# Single source of truth for the stack. Every script sources this file.
# No secrets here — GH_TOKEN / OPENCODE_ZEN_API_KEY live in ~/.hermes/.env on the VPS.

REPO="Abhijit7979/testing-my-agent-layer"
BASE_BRANCH="main"

RUNNER="opencode"            # opencode now; claude-code / codex later (add a case in work-issue.sh)
MODEL="opencode/longcat-2.5-preview-free"
FALLBACK_MODEL="opencode/nemotron-3-ultra-free"
TRIAGE_MODEL="opencode/nemotron-3.5-lightning-free"  # fast free model, run through OpenCode
TRIAGE_USER="triager"        # unprivileged unix user for triage runs

MAX_PARALLEL=2               # tasks in flight at once
TASK_TIMEOUT=1800            # seconds per task (runner time, all attempts)

MERGE_MODE="auto"            # auto = merge on green CI if readiness gate passes; pr = open PR only
BOT_NAME="abhijit-agent-bot"        # git author for agent commits
BOT_EMAIL="aryajitrao@gmail.com"

WORK_ROOT="/srv/agent-work"  # per-issue clones + logs; must be outside HERMES_HOME (runner can't enter it)
RUNNER_USERS="runner1 runner2" # one unprivileged unix user per parallel slot (Dockerfile creates them)

# Hermes strips GH_TOKEN from every child process (it's a "Tier-1" secret even with env_passthrough),
# so the token reaches cron scripts as AGENT_GH_TOKEN and is mapped back for gh/git here.
export GH_TOKEN="${GH_TOKEN:-${AGENT_GH_TOKEN:-}}"

# Changes touching these paths are never auto-shipped (CI config, env files).
PROTECTED_PATHS='^\.github/|(^|/)\.env'
